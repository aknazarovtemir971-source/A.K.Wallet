      );
    case "alert":
      return (
        <svg {...props}>
          <path d="M12 4 21.5 20h-19Z" />
          <path d="M12 10v4.5" />
          <circle cx="12" cy="17.3" r="0.15" fill={color} stroke="none" />
        </svg>
      );
    case "users":
      return (
        <svg {...props}>
          <circle cx="9" cy="8" r="3" />
          <path d="M3.5 19a5.5 5.5 0 0 1 11 0" />
          <path d="M15.5 6.2a3 3 0 0 1 0 5.8" />
          <path d="M17 13.3a5.5 5.5 0 0 1 4 5.7" />
        </svg>
      );
    case "edit":
      return (
        <svg {...props}>
          <path d="M4 16.5V20h3.5L19 8.5l-3.5-3.5Z" />
          <path d="M13 6.5 17.5 11" />
        </svg>
      );
    case "trash":
      return (
        <svg {...props}>
          <path d="M4.5 7h15M9.5 7V5a1.5 1.5 0 0 1 1.5-1.5h2A1.5 1.5 0 0 1 14.5 5v2" />
          <path d="M6.5 7 7.3 19a2 2 0 0 0 2 1.8h5.4a2 2 0 0 0 2-1.8L17.5 7" />
          <path d="M10 11v6M14 11v6" />
        </svg>
      );
    case "check":
      return (
        <svg {...props}>
          <path d="M4.5 12.5 9.5 17.5 19.5 6.5" />
        </svg>
      );
    case "x":
      return (
        <svg {...props}>
          <path d="M5.5 5.5 18.5 18.5M18.5 5.5 5.5 18.5" />
        </svg>
      );
    case "swap":
      return (
        <svg {...props}>
          <path d="M4 8h13.5M14 4l3.5 4L14 12" />
          <path d="M20 16H6.5M10 20l-3.5-4L10 12" />
        </svg>
      );
    case "plus":
      return (
        <svg {...props}>
          <path d="M12 5v14M5 12h14" />
        </svg>
      );
    case "list":
      return (
        <svg {...props}>
          <path d="M8 6h12M8 12h12M8 18h12" />
          <circle cx="4" cy="6" r="1" fill={color} stroke="none" />
          <circle cx="4" cy="12" r="1" fill={color} stroke="none" />
          <circle cx="4" cy="18" r="1" fill={color} stroke="none" />
        </svg>
      );
    case "card":
      return (
        <svg {...props}>
          <rect x="3" y="6" width="18" height="13" rx="2.4" />
          <path d="M3 10.5h18" />
          <path d="M6.5 14.5h4" />
        </svg>
      );
    case "chart":
      return (
        <svg {...props}>
          <path d="M4 20V10M11 20V4M18 20v-7" />
          <path d="M2.5 20h19" />
        </svg>
      );
    case "target":
      return (
        <svg {...props}>
          <circle cx="12" cy="12" r="8.5" />
          <circle cx="12" cy="12" r="4.5" />
          <circle cx="12" cy="12" r="0.6" fill={color} stroke="none" />
        </svg>
      );
    default:
      return null;
  }
}


