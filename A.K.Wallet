          <rect x="5" y="10.5" width="14" height="9.5" rx="2" />
          <path d="M7.5 10.5V7.5a4.5 4.5 0 0 1 8.4-2.2" />
        </svg>
      );
    case "refresh":
      return (
        <svg {...props}>
          <path d="M4 11a8 8 0 0 1 14-4.9M4 6v5h5" />
          <path d="M20 13a8 8 0 0 1-14 4.9M20 18v-5h-5" />
        </svg>
      );
    case "mic":
      return (
        <svg {...props}>
          <rect x="9" y="3" width="6" height="11" rx="3" />
          <path d="M5.5 11a6.5 6.5 0 0 0 13 0" />
          <path d="M12 17.5V21M9 21h6" />
        </svg>
      );
    case "bank":
      return (
