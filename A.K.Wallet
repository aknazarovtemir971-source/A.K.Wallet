// ---------- Seed data ----------
function Icon({ name, size = 16, color = "currentColor", strokeWidth = 1.8 }) {
  const props = {
    width: size,
    height: size,
    viewBox: "0 0 24 24",
    fill: "none",
    stroke: color,
    strokeWidth,
    strokeLinecap: "round",
    strokeLinejoin: "round",
  };
  switch (name) {
    case "burger":
      return (
        <svg {...props}>
          <path d="M3 9c0-3 4-5 9-5s9 2 9 5" />
          <path d="M4 12h16" />
          <path d="M3 15h18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
          <path d="M4 9h16" />
        </svg>
      );
    case "car":
      return (
        <svg {...props}>
          <path d="M4 16V11l2-5h12l2 5v5" />
          <path d="M4 16h16v2a1 1 0 0 1-1 1h-1a1 1 0 0 1-1-1v-1H7v1a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1Z" />
          <circle cx="7.5" cy="16" r="1.4" />
          <circle cx="16.5" cy="16" r="1.4" />
        </svg>
      );
    case "home":
      return (
        <svg {...props}>
          <path d="M4 11.5 12 4l8 7.5" />
          <path d="M6 10v9a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-9" />
          <path d="M10 20v-5h4v5" />
        </svg>
      );
    case "film":
      return (
        <svg {...props}>
          <rect x="3.5" y="4.5" width="17" height="15" rx="2" />
          <path d="M8 4.5v15M16 4.5v15M3.5 9h4.5M3.5 15h4.5M16 9h4.5M16 15h4.5" />
        </svg>
      );
    case "pill":
      return (
        <svg {...props}>
          <rect x="3.5" y="9" width="17" height="6" rx="3" transform="rotate(-45 12 12)" />
          <path d="M9 9 15 15" />
        </svg>
      );
    case "tag":
      return (
        <svg {...props}>
          <path d="M12 3h6a2 2 0 0 1 2 2v6l-9.5 9.5a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8Z" />
          <circle cx="16" cy="8" r="1.3" fill={color} stroke="none" />
        </svg>
      );
    case "lock":
      return (
        <svg {...props}>
          <rect x="5" y="10.5" width="14" height="9.5" rx="2" />
          <path d="M7.5 10.5V7.5a4.5 4.5 0 0 1 9 0v3" />
        </svg>
      );
    case "unlock":
      return (
