function BankBadge({ bank, size = 18 }) {
  const b = BANKS.find((x) => x.name === bank);
  if (!b) return null;
  return (
    <span
      style={{
        width: size,
        height: size,
        borderRadius: size * 0.3,
        background: b.color,
        color: "#fff",
        fontSize: size * 0.36,
        fontWeight: 700,
        display: "inline-flex",
        alignItems: "center",
        justifyContent: "center",
        fontFamily: FONT_MONO,
        flex: "0 0 auto",
        letterSpacing: -0.3,
      }}
    >
      {b.initials}
    </span>
  );
}

const VOICE_KEYWORDS = {
  food: ["еда", "продукты", "кафе", "ресторан", "обед", "ужин", "завтрак", "перекус", "магазин"],
  transport: ["такси", "транспорт", "автобус", "маршрутка", "бензин", "метро"],
  home: ["дом", "коммуналка", "квартира", "аренда", "свет", "вода", "интернет"],
  fun: ["кино", "развлечения", "игра", "концерт", "кафе развлечения", "боулинг"],
  health: ["аптека", "здоровье", "лекарства", "врач", "больница"],
};
const INCOME_KEYWORDS = ["зарплата", "доход", "получил", "получила", "заработал", "подарили", "перевели мне"];

function parseVoiceText(raw) {
  const lower = raw.toLowerCase();
  const numMatch = lower.match(/\d+([.,]\d+)?/);
  const amount = numMatch ? parseFloat(numMatch[0].replace(",", ".")) : null;
  const type = INCOME_KEYWORDS.some((k) => lower.includes(k)) ? "income" : "expense";
  let category = "other";
  for (const key of Object.keys(VOICE_KEYWORDS)) {
    if (VOICE_KEYWORDS[key].some((k) => lower.includes(k))) {
      category = key;
      break;
    }
  }
  const note = raw.trim().charAt(0).toUpperCase() + raw.trim().slice(1);
  return { amount, type, category, note };
}

function daysAgo(n) {
  const d = new Date();
  d.setDate(d.getDate() - n);
  return d.toISOString().slice(0, 10);
}

